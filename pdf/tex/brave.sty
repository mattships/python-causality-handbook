\newcommand*{\headfont}{\smallcapsheadfont\fontsize{8}{10}\selectfont\color{inkgray}}
\newcommand*{\folio}{\headingfont\fontsize{8.5}{10}\selectfont\color{ink}\thepage}

\makepagestyle{brave}

% brave.sty -- book design for "Causal Inference for the Brave and True"
%
% Used with the memoir class and LuaLaTeX.  Trim size 7in x 10in, XCharter
% for text and maths, Fira Sans for display type and tables, Inconsolata
% for code.  The accent colour is the red of the Spartan capes on the cover.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{brave}[2026/10/26 Brave and True book design]

% ---------------------------------------------------------------------------
% Page geometry
% ---------------------------------------------------------------------------
\setstocksize{10in}{7in}
\settrimmedsize{\stockheight}{\stockwidth}{*}
\settypeblocksize{8.05in}{5.25in}{*}
\setlrmargins{0.82in}{*}{*}          % spine margin; the outer one gets the rest
\setulmargins{0.9in}{*}{*}
\setheadfoot{13pt}{0.45in}
\setheaderspaces{*}{0.28in}{*}
\setmarginnotes{0.15in}{0.7in}{0.1in}
\checkandfixthelayout[nearest]

% ---------------------------------------------------------------------------
% Fonts
% ---------------------------------------------------------------------------
\RequirePackage{amsmath}
\RequirePackage{fontspec}
\RequirePackage[math-style=TeX,bold-style=TeX]{unicode-math}

\setmainfont{XCharter}[
  Extension      = .otf,
  UprightFont    = *-Roman,
  BoldFont       = *-Bold,
  ItalicFont     = *-Italic,
  BoldItalicFont = *-BoldItalic,
  SlantedFont    = *-Slanted,
  Numbers        = Lining,
]
\setsansfont{FiraSans}[
  Extension      = .otf,
  UprightFont    = *-Book,
  BoldFont       = *-SemiBold,
  ItalicFont     = *-BookItalic,
  BoldItalicFont = *-SemiBoldItalic,
  Scale          = MatchLowercase,
]
\setmonofont{Inconsolatazi4}[
  Extension      = .otf,
  UprightFont    = *-Regular,
  BoldFont       = *-Bold,
  Scale          = MatchLowercase,
]
\setmathfont{XCharter-Math.otf}
% Bold maths letters: MathJax's \pmb is bold italic for letters.
\AtBeginDocument{\renewcommand{\pmb}[1]{\symbfit{#1}}}

\newfontfamily\headingfont{FiraSans}[
  Extension = .otf, UprightFont = *-SemiBold, BoldFont = *-Bold,
  ItalicFont = *-SemiBoldItalic, Scale = MatchLowercase]
\newfontfamily\headinglightfont{FiraSans}[
  Extension = .otf, UprightFont = *-Light, BoldFont = *-Regular,
  ItalicFont = *-LightItalic, Scale = MatchLowercase]
\newfontfamily\headingmediumfont{FiraSans}[
  Extension = .otf, UprightFont = *-Medium, BoldFont = *-SemiBold,
  ItalicFont = *-MediumItalic, Scale = MatchLowercase]
\newfontfamily\tablefont{FiraSans}[
  Extension = .otf, UprightFont = *-Book, BoldFont = *-Medium,
  ItalicFont = *-BookItalic, Scale = MatchLowercase,
  Numbers = {Lining, Monospaced}]
\newfontfamily\smallcapsheadfont{FiraSans}[
  Extension = .otf, UprightFont = *-Book, BoldFont = *-SemiBold,
  Scale = MatchLowercase, Letters = {SmallCaps, UppercaseSmallCaps},
  LetterSpace = 5]

\linespread{1.1}

\RequirePackage[english]{babel}
\RequirePackage[protrusion=true,expansion=true,final]{microtype}
\RequirePackage{xcolor}

% ---------------------------------------------------------------------------
% Colour
% ---------------------------------------------------------------------------
\definecolor{accent}{HTML}{9A1F26}
\definecolor{accentdark}{HTML}{7A171D}
\definecolor{ink}{HTML}{1E1B19}
\definecolor{inkgray}{HTML}{5F5852}
\definecolor{rulegray}{HTML}{C9C1B8}
\definecolor{codebg}{HTML}{F6F3EE}
\definecolor{outrule}{HTML}{D3CBC1}
\definecolor{covernight}{HTML}{151210}
\definecolor{covercream}{HTML}{F3EBDD}

% ---------------------------------------------------------------------------
% Paragraphs, lists, justification
% ---------------------------------------------------------------------------
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.5\baselineskip plus 2pt minus 1pt}
\raggedbottom
\setlength{\emergencystretch}{2em}
\tolerance=1500
\widowpenalty=10000
\clubpenalty=10000
\brokenpenalty=5000

\RequirePackage{enumitem}
\setlist{topsep=0.2\baselineskip, partopsep=0pt, itemsep=0.25\baselineskip,
  parsep=0pt, leftmargin=1.6em}
\setlist[itemize,1]{label={\color{accent}\small\textbullet}}
\setlist[itemize,2]{label={\color{inkgray}\textendash}}
\setlist[enumerate,1]{label={\headingmediumfont\color{accent}\arabic*.}}
\providecommand{\tightlist}{\setlength{\itemsep}{0.15\baselineskip}\setlength{\parskip}{0pt}}

% ---------------------------------------------------------------------------
% Packages for content
% ---------------------------------------------------------------------------
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{longtable}
\RequirePackage{array}
\RequirePackage{calc}
\RequirePackage{adjustbox}
\RequirePackage{fvextra}
\RequirePackage[most]{tcolorbox}
\RequirePackage{tikz}
\usetikzlibrary{calc,fadings}
\RequirePackage{etoolbox}

\setlength{\abovedisplayskip}{6pt plus 2pt minus 2pt}
\setlength{\belowdisplayskip}{6pt plus 2pt minus 2pt}
\setlength{\abovedisplayshortskip}{2pt plus 2pt}
\setlength{\belowdisplayshortskip}{4pt plus 2pt minus 1pt}
\AtBeginDocument{%
  \setlength{\abovedisplayskip}{6pt plus 2pt minus 2pt}%
  \setlength{\belowdisplayskip}{6pt plus 2pt minus 2pt}}

% Display maths is set through \fitmath, which scales the rare equation
% that is wider than the text block down to fit it.
\newsavebox{\fitmathbox}
\newcommand{\fitmath}[1]{%
  \sbox{\fitmathbox}{$\displaystyle #1$}%
  \ifdim\wd\fitmathbox>\linewidth
    \resizebox{\linewidth}{!}{\usebox{\fitmathbox}}%
  \else
    \usebox{\fitmathbox}%
  \fi}
% Display maths that has no paragraph of its own to sit in.
\newenvironment{displaypara}
  {\par\addvspace{4pt}\begingroup\centering}
  {\par\endgroup\addvspace{4pt}}

% ---------------------------------------------------------------------------
% Headings
% ---------------------------------------------------------------------------
\setsecnumdepth{chapter}
\maxsecnumdepth{chapter}
\setcounter{tocdepth}{1}            % (\settocdepth would write into the .toc)

\setsecheadstyle{\headingfont\fontsize{14.5}{17}\selectfont\color{accent}\raggedright}
\setbeforesecskip{-1.5\onelineskip plus -0.5\onelineskip minus -0.2\onelineskip}
\setaftersecskip{0.45\onelineskip plus 0.1\onelineskip}

\setsubsecheadstyle{\headingfont\fontsize{11.5}{14}\selectfont\color{ink}\raggedright}
\setbeforesubsecskip{-1.1\onelineskip plus -0.4\onelineskip minus -0.2\onelineskip}
\setaftersubsecskip{0.3\onelineskip plus 0.1\onelineskip}

\setsubsubsecheadstyle{\headingmediumfont\normalsize\itshape\color{ink}\raggedright}
\setbeforesubsubsecskip{-0.9\onelineskip plus -0.3\onelineskip}
\setaftersubsubsecskip{0.2\onelineskip}

\setparaheadstyle{\headingmediumfont\normalsize\color{ink}}

% --- chapter openers ------------------------------------------------------
\newcommand*{\chapterlabelfont}{\headingfont\fontsize{8.5}{10}\selectfont
  \addfontfeatures{LetterSpace=22}\color{accent}}
\makechapterstyle{brave}{%
  \setlength{\beforechapskip}{0pt}%
  \setlength{\midchapskip}{0pt}%
  \setlength{\afterchapskip}{2.4\onelineskip}%
  \renewcommand*{\chapterheadstart}{\vspace*{0.55in}}%
  \renewcommand*{\printchaptername}{}%
  \renewcommand*{\chapternamenum}{}%
  \renewcommand*{\printchapternum}{%
    \begingroup\raggedright
      {\chapterlabelfont\MakeUppercase{\@chapapp}}\par\nointerlineskip\vspace{2pt}%
      {\headinglightfont\fontsize{66}{66}\selectfont\color{accent}\thechapter}\par
    \endgroup}%
  \renewcommand*{\afterchapternum}{%
    \vspace{6pt}{\color{rulegray}\rule{\linewidth}{0.6pt}}\par\vspace{14pt}}%
  \renewcommand*{\printchapternonum}{%
    \vspace*{72pt}{\color{rulegray}\rule{\linewidth}{0.6pt}}\par\vspace{14pt}}%
  \renewcommand*{\printchaptertitle}[1]{%
    \begingroup\raggedright\headingfont\fontsize{25}{30}\selectfont\color{ink}##1\par\endgroup}%
  \renewcommand*{\afterchaptertitle}{\par\nobreak\vskip\afterchapskip}%
}
\chapterstyle{brave}

% --- part pages -------------------------------------------------------------
\renewcommand*{\partnamefont}{\headingfont\fontsize{10}{12}\selectfont
  \addfontfeatures{LetterSpace=25}\color{accent}}
\renewcommand*{\partnumfont}{\partnamefont}
\renewcommand*{\printpartname}{\partnamefont\MakeUppercase{\partname}}
\renewcommand*{\printpartnum}{\partnumfont\thepart}
\renewcommand*{\midpartskip}{\par\vspace{18pt}}
\renewcommand*{\parttitlefont}{\headinglightfont\fontsize{46}{52}\selectfont\color{ink}}
\newif\ifappendixpart
\renewcommand*{\printparttitle}[1]{%
  \ifappendixpart\phantomsection\addcontentsline{toc}{part}{#1}\fi
  \parttitlefont #1\par
  \vspace{22pt}{\color{accent}\rule{2.2em}{2pt}}\par
  \ifappendixpart\else
    \vspace{1.1in}%
    \ifnum\value{part}=1 \yinyang{0.38in}\else\yinyang[180]{0.38in}\fi\par
  \fi}
\renewcommand*{\beforepartskip}{\vspace*{1.5in}}
\newcommand*{\bravepart}[1]{\part{#1}}
\newcommand*{\appendixpart}{\appendixparttrue\part*{Appendices}\appendixpartfalse}

% A yin--yang mark for the part pages (Part I is "The Yang", Part II "The Yin").
\newcommand*{\yinyang}[2][0]{%
  \begin{tikzpicture}[rotate=#1, line width=0.7pt]
    \def\yyr{#2}
    \fill[accent] (0,0) circle (\yyr);
    \fill[white] (0,\yyr) arc (90:270:\yyr) arc (-90:90:\yyr/2) arc (-90:-270:\yyr/2) -- cycle;
    \fill[white] (0,\yyr/2) circle (\yyr/7);
    \fill[accent] (0,-\yyr/2) circle (\yyr/7);
    \draw[accent] (0,0) circle (\yyr);
  \end{tikzpicture}}


% ---------------------------------------------------------------------------
% Code, outputs, inline code
% ---------------------------------------------------------------------------
\newcommand*{\codesize}{\fontsize{8.6}{10.6}\selectfont}
\newcommand*{\code}[1]{\texttt{#1}}
% A break inside an identifier is allowed but costs about as much as a hyphen.
\newcommand*{\codebreak}{\penalty300\relax}

% The syntax-highlighting macros come from pandoc (highlighting.tex); the
% environments are defined here so that long lines wrap.
% build.py wraps long lines itself (at commas, dots and brackets, never in
% a string) and marks continuations with \codecont; fvextra's own wrapping
% at spaces is the fallback and is drawn the same way.
\newcommand*{\codebreaksymbol}{\textcolor{rulegray}{\ensuremath{\hookrightarrow}}}
\newcommand*{\codecont}{\llap{\codebreaksymbol\hspace{2.5pt}}}
\DefineVerbatimEnvironment{Highlighting}{Verbatim}{%
  commandchars=\\\{\}, fontsize=\codesize, breaklines, breakautoindent,
  breakindent=18.1pt, breaksymbolleft=\codebreaksymbol, breaksymbolsepleft=2.5pt}

\tcbset{codestyle/.style={enhanced, colback=codebg, colframe=codebg,
  boxrule=0pt, arc=1.2pt, outer arc=1.2pt, left=7pt, right=5pt, top=3.5pt,
  bottom=3.5pt, boxsep=0pt,
  borderline west={1.6pt}{0pt}{accent!75},
  before skip=7pt plus 2pt, after skip=5pt plus 2pt}}
\newtcolorbox{codebox}{codestyle, breakable}
\newtcolorbox{codeboxkeep}{codestyle}
% filters/book.lua puts \keepnextcode before short listings.
\newif\ifkeepnextcode
\newcommand*{\keepnextcode}{\global\keepnextcodetrue}
\newenvironment{Shaded}
  {\ifkeepnextcode\global\keepnextcodefalse\def\shadedbox{codeboxkeep}%
   \else\def\shadedbox{codebox}\fi
   \begin{\shadedbox}}
  {\end{\shadedbox}}

% Code written in the text without a language: boxed, not highlighted.
\DefineVerbatimEnvironment{plaincode}{Verbatim}{%
  fontsize=\codesize, breaklines, breakanywhere, breaksymbolleft=\codebreaksymbol}

% Plain-text cell output: a hairline on the left, no tint.
\DefineVerbatimEnvironment{pyout}{Verbatim}{%
  fontsize=\codesize, formatcom=\color{ink!85}, breaklines, breakanywhere,
  breaksymbolleft=\codebreaksymbol, frame=leftline, framerule=0.9pt,
  rulecolor=\color{outrule}, framesep=6.5pt, xleftmargin=1.2pt}
\BeforeBeginEnvironment{pyout}{\par\addvspace{3pt}}
\AfterEndEnvironment{pyout}{\par\addvspace{6pt}}


% ---------------------------------------------------------------------------
% Images, quotes, section breaks, links
% ---------------------------------------------------------------------------
% \bookimage{width}{height}{file}: centred, never floating.  When the
% picture would just miss the bottom of the page, shrink it (to no less
% than 70%) rather than leave a hole.
\newlength{\bookimgh}
\newlength{\bookimgroom}
\newcommand*{\bookimage}[3]{%
  \par\addvspace{6pt}%
  \begingroup
    \setlength{\bookimgh}{#2}%
    \ifdim\pagegoal<\maxdimen
      \setlength{\bookimgroom}{\dimexpr\pagegoal-\pagetotal-\parskip-4pt\relax}%
      \ifdim\bookimgroom<\bookimgh
        \ifdim\bookimgroom>0.7\bookimgh \setlength{\bookimgh}{\bookimgroom}\fi
      \fi
    \fi
    {\centering\includegraphics[width=#1,height=\bookimgh,keepaspectratio]{#3}\par}%
  \endgroup
  \addvspace{8pt}}

\newtcolorbox{bravequote}{enhanced, breakable, blank, left=11pt, right=6pt,
  top=1pt, bottom=1pt, borderline west={1.1pt}{0pt}{accent!55},
  before skip=6pt, after skip=8pt, fontupper=\small\color{ink!90}}
\renewenvironment{quote}{\begin{bravequote}\setlength{\parskip}{0.35\baselineskip}}{\end{bravequote}}

% Notes and other asides (MyST admonitions in the notebooks).
\newtcolorbox{bookaside}[1]{enhanced, breakable, colback=accent!3.5!white,
  colframe=accent!3.5!white, boxrule=0pt, arc=1.5pt, outer arc=1.5pt,
  left=11pt, right=11pt, top=8pt, bottom=8pt, boxsep=0pt,
  borderline north={0.8pt}{0pt}{accent!70}, fontupper=\small,
  before upper={{\chapterlabelfont\MakeUppercase{#1}}\par\vspace{4pt}%
    \setlength{\parskip}{0.4\baselineskip}},
  before skip=8pt plus 2pt, after skip=8pt plus 2pt}

\newcommand*{\bookbreak}{\par\addvspace{6pt}%
  {\centering\color{accent}\headingfont\small\textasteriskcentered\quad\textasteriskcentered\quad\textasteriskcentered\par}%
  \addvspace{6pt}}


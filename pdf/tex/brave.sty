\makeoddhead{brave}{}{}{\headfont\rightmark\hspace{1.4em}\folio}
\makeevenfoot{brave}{}{}{}
\makeoddfoot{brave}{}{}{}
\nouppercaseheads
\makepsmarks{brave}{%

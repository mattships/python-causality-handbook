% book.sty -- publisher-style book design for the book-pdf skill.
%
% Used with the memoir class and LuaLaTeX.  Everything that varies from
% book to book (trim size, fonts, accent colour, language, metadata) is set
% in bookconfig.tex, which book.py writes and \input's before this package.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{book}[2026/10/26 book-pdf design]

\RequirePackage{etoolbox}

% Defaults for anything bookconfig.tex leaves out.
\providecommand*{\bookStockWidth}{7in}
\providecommand*{\bookStockHeight}{10in}
\providecommand*{\bookTextWidth}{5.25in}
\providecommand*{\bookTextHeight}{8.05in}
\providecommand*{\bookSpineMargin}{0.82in}
\providecommand*{\bookTopMargin}{0.9in}
\providecommand*{\bookFontSet}{charter}
\providecommand*{\bookAccent}{9A1F26}
\providecommand*{\bookLanguage}{english}
\providecommand*{\bookCodeSize}{8.6}
\providecommand*{\bookCodeLeading}{10.6}
\providecommand*{\bookCoverAccent}{}

% ---------------------------------------------------------------------------
% Page geometry
% ---------------------------------------------------------------------------
\setstocksize{\bookStockHeight}{\bookStockWidth}
\settrimmedsize{\stockheight}{\stockwidth}{*}
\settypeblocksize{\bookTextHeight}{\bookTextWidth}{*}
\setlrmargins{\bookSpineMargin}{*}{*}   % spine margin; the outer one gets the rest
\setulmargins{\bookTopMargin}{*}{*}
\setheadfoot{13pt}{0.45in}
\setheaderspaces{*}{0.28in}{*}
\setmarginnotes{0.15in}{0.7in}{0.1in}
\checkandfixthelayout[nearest]

% ---------------------------------------------------------------------------
% Fonts
% ---------------------------------------------------------------------------
\RequirePackage{amsmath}
\RequirePackage{fontspec}
\RequirePackage[math-style=TeX,bold-style=TeX]{unicode-math}

% Glyphs missing from the book's fonts (arrows, box drawing, symbols) come
% from DejaVu; bookconfig.tex may add more fonts (e.g. a CJK one).
\providecommand*{\bookFallbackText}{"DejaVuSans:mode=harf;", "DejaVuSansMono:mode=harf;"}
\providecommand*{\bookFallbackMono}{"DejaVuSansMono:mode=harf;", "DejaVuSans:mode=harf;"}
\directlua{
  luaotfload.add_fallback("booktext", {\bookFallbackText})
  luaotfload.add_fallback("bookmono", {\bookFallbackMono})
}
\newcommand*{\bookFB}{RawFeature={fallback=booktext}}

% \booksans{weight family command}{upright}{bold}{italic}{extra} for the
% heading and table faces, so that every font set defines the same names.
\newcommand*{\bookfamily}[6]{%
  \newfontfamily#1{#2}[Extension=.otf, UprightFont=#3, BoldFont=#4,
    ItalicFont=#5, Scale=MatchLowercase, RawFeature={fallback=booktext}, #6]}

\ifdefstring{\bookFontSet}{libertinus}{%
  \setmainfont{LibertinusSerif}[Extension=.otf, UprightFont=*-Regular,
    BoldFont=*-Semibold, ItalicFont=*-Italic, BoldItalicFont=*-SemiboldItalic,
    Numbers=Lining, \bookFB]
  \setsansfont{LibertinusSans}[Extension=.otf, UprightFont=*-Regular,
    BoldFont=*-Bold, ItalicFont=*-Italic, Scale=MatchLowercase, \bookFB]
  \setmonofont{Inconsolatazi4}[Extension=.otf, UprightFont=*-Regular,
    BoldFont=*-Bold, Scale=MatchLowercase, RawFeature={fallback=bookmono}]
  \setmathfont{LibertinusMath-Regular.otf}
  \bookfamily\headingfont{LibertinusSans}{*-Bold}{*-Bold}{*-Italic}{}
  \bookfamily\headinglightfont{LibertinusSans}{*-Regular}{*-Bold}{*-Italic}{}
  \bookfamily\headingmediumfont{LibertinusSans}{*-Bold}{*-Bold}{*-Italic}{}
  \bookfamily\tablefont{LibertinusSans}{*-Regular}{*-Bold}{*-Italic}{Numbers={Lining,Monospaced}}
}{}
\ifdefstring{\bookFontSet}{stix}{%
  \setmainfont{STIXTwoText}[Extension=.otf, UprightFont=*-Regular,
    BoldFont=*-Bold, ItalicFont=*-Italic, BoldItalicFont=*-BoldItalic,
    Numbers=Lining, \bookFB]
  \setsansfont{SourceSansPro}[Extension=.otf, UprightFont=*-Regular,
    BoldFont=*-Semibold, ItalicFont=*-RegularIt, BoldItalicFont=*-SemiboldIt,
    Scale=MatchLowercase, \bookFB]
  \setmonofont{SourceCodePro}[Extension=.otf, UprightFont=*-Regular,
    BoldFont=*-Bold, Scale=MatchLowercase, RawFeature={fallback=bookmono}]
  \setmathfont{STIXTwoMath-Regular.otf}
  \bookfamily\headingfont{SourceSansPro}{*-Semibold}{*-Bold}{*-SemiboldIt}{}
  \bookfamily\headinglightfont{SourceSansPro}{*-Light}{*-Regular}{*-LightIt}{}
  \bookfamily\headingmediumfont{SourceSansPro}{*-Semibold}{*-Bold}{*-SemiboldIt}{}
  \bookfamily\tablefont{SourceSansPro}{*-Regular}{*-Semibold}{*-RegularIt}{Numbers={Lining,Monospaced}}
}{}
\ifdefstring{\bookFontSet}{lm}{%
  \setmainfont{Latin Modern Roman}[\bookFB]
  \setsansfont{Latin Modern Sans}[\bookFB]
  \setmonofont{Latin Modern Mono}[RawFeature={fallback=bookmono}]
  \setmathfont{latinmodern-math.otf}
  \newfontfamily\headingfont{Latin Modern Sans}[\bookFB]
  \newfontfamily\headinglightfont{Latin Modern Sans}[\bookFB]
  \newfontfamily\headingmediumfont{Latin Modern Sans}[\bookFB]
  \newfontfamily\tablefont{Latin Modern Sans}[\bookFB]
}{}
\ifcsdef{headingfont}{}{%   charter, the default
  \setmainfont{XCharter}[Extension=.otf, UprightFont=*-Roman, BoldFont=*-Bold,
    ItalicFont=*-Italic, BoldItalicFont=*-BoldItalic, SlantedFont=*-Slanted,
    Numbers=Lining, \bookFB]
  \setsansfont{FiraSans}[Extension=.otf, UprightFont=*-Book, BoldFont=*-SemiBold,
    ItalicFont=*-BookItalic, BoldItalicFont=*-SemiBoldItalic,
    Scale=MatchLowercase, \bookFB]
  \setmonofont{Inconsolatazi4}[Extension=.otf, UprightFont=*-Regular,
    BoldFont=*-Bold, Scale=MatchLowercase, RawFeature={fallback=bookmono}]
  \setmathfont{XCharter-Math.otf}
  \bookfamily\headingfont{FiraSans}{*-SemiBold}{*-Bold}{*-SemiBoldItalic}{}
  \bookfamily\headinglightfont{FiraSans}{*-Light}{*-Regular}{*-LightItalic}{}
  \bookfamily\headingmediumfont{FiraSans}{*-Medium}{*-SemiBold}{*-MediumItalic}{}
  \bookfamily\tablefont{FiraSans}{*-Book}{*-Medium}{*-BookItalic}{Numbers={Lining,Monospaced}}
}
% Bold maths letters: MathJax's \pmb is bold italic for letters.
\AtBeginDocument{\renewcommand{\pmb}[1]{\symbfit{#1}}}

\linespread{1.1}

\RequirePackage[\bookLanguage]{babel}
\RequirePackage[protrusion=true,expansion=true,final]{microtype}
\RequirePackage{xcolor}

% ---------------------------------------------------------------------------
% Colour
% ---------------------------------------------------------------------------
\definecolor{accent}{HTML}{\bookAccent}
\colorlet{accentdark}{accent!80!black}
\definecolor{ink}{HTML}{1E1B19}
\definecolor{inkgray}{HTML}{5F5852}
\definecolor{rulegray}{HTML}{C9C1B8}
\definecolor{codebg}{HTML}{F6F3EE}
\definecolor{outrule}{HTML}{D3CBC1}
\definecolor{covernight}{HTML}{151210}
\definecolor{covercream}{HTML}{F3EBDD}
% Tints over the dark cover must be mixed into the ground, not into white:
% \covertint{70} is 70% cream on the cover's dark ground.
\newcommand*{\covertint}[1]{\color{covercream!#1!covernight}}
% The accent lightened, for type on the dark cover (bookconfig may set it).
\ifdefempty{\bookCoverAccent}{\colorlet{coveraccent}{accent!62!white}}{\definecolor{coveraccent}{HTML}{\bookCoverAccent}}

% ---------------------------------------------------------------------------
% Paragraphs, lists, justification
% ---------------------------------------------------------------------------
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.5\baselineskip plus 2pt minus 1pt}
\raggedbottom
\setlength{\emergencystretch}{2em}
\tolerance=1500
\widowpenalty=10000
\clubpenalty=10000
\brokenpenalty=5000

\RequirePackage{enumitem}
\setlist{topsep=0.2\baselineskip, partopsep=0pt, itemsep=0.25\baselineskip,
  parsep=0pt, leftmargin=1.6em}
\setlist[itemize,1]{label={\color{accent}\small\textbullet}}
\setlist[itemize,2]{label={\color{inkgray}\textendash}}
\setlist[enumerate,1]{label={\headingmediumfont\color{accent}\arabic*.}}
\providecommand{\tightlist}{\setlength{\itemsep}{0.15\baselineskip}\setlength{\parskip}{0pt}}

% ---------------------------------------------------------------------------
% Packages for content
% ---------------------------------------------------------------------------
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{longtable}
\RequirePackage{array}
\RequirePackage{multirow}
\RequirePackage{calc}
\RequirePackage{adjustbox}
\RequirePackage{fvextra}
\RequirePackage[most]{tcolorbox}
\RequirePackage{tikz}
\usetikzlibrary{calc,fadings}
\RequirePackage{caption}
\captionsetup{font={small,sf}, labelfont={color=accent}, justification=centering,
  singlelinecheck=true, skip=4pt}

% pandoc's LaTeX writer uses these (its table widths also use calc's \real).
\providecommand{\pandocbounded}[1]{#1}
\providecommand{\passthrough}[1]{#1}
\RequirePackage{luacolor}
\RequirePackage[soul]{lua-ul}           % \st, \hl and \ul under LuaLaTeX

\setlength{\abovedisplayskip}{6pt plus 2pt minus 2pt}
\setlength{\belowdisplayskip}{6pt plus 2pt minus 2pt}
\setlength{\abovedisplayshortskip}{2pt plus 2pt}
\setlength{\belowdisplayshortskip}{4pt plus 2pt minus 1pt}
\AtBeginDocument{%
  \setlength{\abovedisplayskip}{6pt plus 2pt minus 2pt}%
  \setlength{\belowdisplayskip}{6pt plus 2pt minus 2pt}}

% Display maths is set through \fitmath, which scales the rare equation
% that is wider than the text block down to fit it.
\newsavebox{\fitmathbox}
\newcommand{\fitmath}[1]{%
  \sbox{\fitmathbox}{$\displaystyle #1$}%
  \ifdim\wd\fitmathbox>\linewidth
    \resizebox{\linewidth}{!}{\usebox{\fitmathbox}}%
  \else
    \usebox{\fitmathbox}%
  \fi}
% Display maths that has no paragraph of its own to sit in.
\newenvironment{displaypara}
  {\par\addvspace{4pt}\begingroup\centering}
  {\par\endgroup\addvspace{4pt}}

% ---------------------------------------------------------------------------
% Headings
% ---------------------------------------------------------------------------
\setsecnumdepth{chapter}
\maxsecnumdepth{chapter}
\setcounter{tocdepth}{1}            % (\settocdepth would write into the .toc)

\setsecheadstyle{\headingfont\fontsize{14.5}{17}\selectfont\color{accent}\raggedright}
\setbeforesecskip{-1.5\onelineskip plus -0.5\onelineskip minus -0.2\onelineskip}
\setaftersecskip{0.45\onelineskip plus 0.1\onelineskip}

\setsubsecheadstyle{\headingfont\fontsize{11.5}{14}\selectfont\color{ink}\raggedright}
\setbeforesubsecskip{-1.1\onelineskip plus -0.4\onelineskip minus -0.2\onelineskip}
\setaftersubsecskip{0.3\onelineskip plus 0.1\onelineskip}

\setsubsubsecheadstyle{\headingmediumfont\normalsize\itshape\color{ink}\raggedright}
\setbeforesubsubsecskip{-0.9\onelineskip plus -0.3\onelineskip}
\setaftersubsubsecskip{0.2\onelineskip}

\setparaheadstyle{\headingmediumfont\normalsize\color{ink}}
\setsubparaheadstyle{\headingmediumfont\small\color{inkgray}}

% --- chapter openers ------------------------------------------------------
\newcommand*{\chapterlabelfont}{\headingfont\fontsize{8.5}{10}\selectfont
  \addfontfeatures{LetterSpace=22}\color{accent}}
\makechapterstyle{bookpdf}{%
  \setlength{\beforechapskip}{0pt}%
  \setlength{\midchapskip}{0pt}%
  \setlength{\afterchapskip}{2.4\onelineskip}%
  \renewcommand*{\chapterheadstart}{\vspace*{0.55in}}%
  \renewcommand*{\printchaptername}{}%
  \renewcommand*{\chapternamenum}{}%
  \renewcommand*{\printchapternum}{%
    \begingroup\raggedright
      {\chapterlabelfont\MakeUppercase{\@chapapp}}\par\nointerlineskip\vspace{2pt}%
      {\headinglightfont\fontsize{66}{66}\selectfont\color{accent}\thechapter}\par
    \endgroup}%
  \renewcommand*{\afterchapternum}{%
    \vspace{6pt}{\color{rulegray}\rule{\linewidth}{0.6pt}}\par\vspace{14pt}}%
  \renewcommand*{\printchapternonum}{%
    \vspace*{72pt}{\color{rulegray}\rule{\linewidth}{0.6pt}}\par\vspace{14pt}}%
  \renewcommand*{\printchaptertitle}[1]{%
    \begingroup\raggedright\headingfont\fontsize{25}{30}\selectfont\color{ink}##1\par\endgroup}%
  \renewcommand*{\afterchaptertitle}{\par\nobreak\vskip\afterchapskip}%
}
\chapterstyle{bookpdf}

% --- part pages -------------------------------------------------------------
\renewcommand*{\partnamefont}{\headingfont\fontsize{10}{12}\selectfont
  \addfontfeatures{LetterSpace=25}\color{accent}}
\renewcommand*{\partnumfont}{\partnamefont}
\renewcommand*{\printpartname}{\partnamefont\MakeUppercase{\partname}}
\renewcommand*{\printpartnum}{\partnumfont\thepart}
\renewcommand*{\midpartskip}{\par\vspace{18pt}}
\renewcommand*{\parttitlefont}{\headinglightfont\fontsize{46}{52}\selectfont\color{ink}}
\newif\ifappendixpart
\renewcommand*{\printparttitle}[1]{%
  \ifappendixpart\phantomsection\addcontentsline{toc}{part}{#1}\fi

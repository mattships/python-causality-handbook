% ---------------------------------------------------------------------------
% Images, captions, quotes, asides, section breaks, links
% ---------------------------------------------------------------------------
% \bookimage{width}{height}{file}: centred, never floating.  When the
% picture would just miss the bottom of the page, shrink it (to no less
% than 70%) rather than leave a hole.
\newlength{\bookimgh}
\newlength{\bookimgroom}
\newcommand*{\bookimage}[3]{%
  \par\addvspace{6pt}%
  \begingroup
    \setlength{\bookimgh}{#2}%
    \ifdim\pagegoal<\maxdimen
      \setlength{\bookimgroom}{\dimexpr\pagegoal-\pagetotal-\parskip-4pt\relax}%
      \ifdim\bookimgroom<\bookimgh
        \ifdim\bookimgroom>0.7\bookimgh \setlength{\bookimgh}{\bookimgroom}\fi
      \fi
    \fi
    {\centering\includegraphics[width=#1,height=\bookimgh,keepaspectratio]{#3}\par}%
  \endgroup
  \addvspace{8pt}}
% A captioned picture: the image, then its caption in small sans.  With a
% label (\bookcaption[fig-x]{...}) the figure is numbered: Figure 3.2.
\newcounter{bookfigure}[chapter]
\renewcommand*{\thebookfigure}{\thechapter.\arabic{bookfigure}}
\newcommand*{\bookcaption}[2][]{\par\nopagebreak\vspace{-4pt}%
  {\centering\begin{minipage}{0.86\linewidth}\centering\small\sffamily\color{inkgray}%
   \ifstrempty{#1}{}{\refstepcounter{bookfigure}\label{#1}%
     {\color{accent}\figurename~\thebookfigure}\ifstrempty{#2}{}{\quad}}#2%
   \end{minipage}\par}%
  \addvspace{8pt}}
% A table's caption when the table is not numbered (numbered ones use \caption).
\newcommand*{\booktablecaption}[1]{\par\nopagebreak
  {\centering\begin{minipage}{0.86\linewidth}\centering\small\sffamily\color{inkgray}#1\end{minipage}\par}%
  \nopagebreak\vspace{2pt}}
% Image that could not be included (unsupported format, unreachable URL).
\newcommand*{\missingimage}[1]{\par\addvspace{6pt}%
  {\centering\fbox{\parbox{0.6\linewidth}{\centering\small\color{inkgray}#1}}\par}\addvspace{8pt}}

\newtcolorbox{bookquote}{enhanced, breakable, blank, left=11pt, right=6pt,
  top=1pt, bottom=1pt, borderline west={1.1pt}{0pt}{accent!55},
  before skip=6pt, after skip=8pt, fontupper=\small\color{ink!90}}
\renewenvironment{quote}{\begin{bookquote}\setlength{\parskip}{0.35\baselineskip}}{\end{bookquote}}

% Notes, warnings, "new in version" and other asides.
\newtcolorbox{bookaside}[1]{enhanced, breakable, colback=accent!3.5!white,
  colframe=accent!3.5!white, boxrule=0pt, arc=1.5pt, outer arc=1.5pt,
  left=11pt, right=11pt, top=8pt, bottom=8pt, boxsep=0pt,
  borderline north={0.8pt}{0pt}{accent!70}, fontupper=\small,
  before upper={{\chapterlabelfont\MakeUppercase{#1}}\par\vspace{4pt}%
    \setlength{\parskip}{0.4\baselineskip}},
  before skip=8pt plus 2pt, after skip=8pt plus 2pt}
% API entries (Sphinx autodoc and friends): signature, then the docstring.
% The body is indented by the box's left padding (not \leftskip), so that
% boxes nested in an entry fit; the signature hangs out into the margin.
\newtcolorbox{bookapi}[1]{enhanced, breakable, blank, left=1.2em, right=0pt,
  top=2pt, bottom=2pt, before skip=8pt plus 2pt, after skip=6pt plus 2pt,
  before upper={{\raggedright\hspace*{-1.2em}\ttfamily\small\color{accentdark}#1\par}%
    \nopagebreak\vspace{3pt}\setlength{\parskip}{0.4\baselineskip}},
  borderline north={0.4pt}{0pt}{rulegray}}

\newcommand*{\bookbreak}{\par\addvspace{6pt}%
  {\centering\color{accent}\headingfont\small\textasteriskcentered\quad\textasteriskcentered\quad\textasteriskcentered\par}%
  \addvspace{6pt}}

% Definition lists (glossaries, option lists).
\setlist[description]{font={\headingmediumfont\color{ink}}, leftmargin=1.6em, labelindent=0pt,
  style=nextline, itemsep=0.3\baselineskip}

% ---------------------------------------------------------------------------
% Index (entries are marked by book.lua from the book's index terms)
% ---------------------------------------------------------------------------
\makeindex
\renewcommand*{\seename}{\textit{see}}
\setlength{\columnsep}{2.2em}
\newcommand*{\indexgroup}[1]{\par\addvspace{9pt}%
  {\headingfont\small\color{accent}#1}\par\nopagebreak\vspace{1pt}}
\AtBeginEnvironment{theindex}{\raggedright\hyphenpenalty=10000\exhyphenpenalty=10000}
\providecommand*{\bookindexnote}{Page ranges in the index mark the chapter devoted to
  a topic; other entries point to where it is put to work elsewhere.}
\renewcommand*{\preindexhook}{%
  \ifdefempty{\bookindexnote}{}{{\small\color{inkgray}\bookindexnote\par}\vspace{10pt}}}

% Bibliographies formatted by pandoc's citeproc (book.yaml: bibliography).
\newlength{\cslhangindent}\setlength{\cslhangindent}{1.6em}
\newlength{\csllabelwidth}\setlength{\csllabelwidth}{3em}
\newlength{\cslentryspacingunit}\setlength{\cslentryspacingunit}{\parskip}
\newenvironment{CSLReferences}[2]
  {\par\begingroup\small\raggedright\setlength{\parindent}{0pt}%
   \ifodd #1 \let\oldpar\par\def\par{\hangindent=\cslhangindent\oldpar}\fi
   \ifnum #2=0 \setlength{\parskip}{4pt plus 1pt}\else
     \setlength{\parskip}{#2\cslentryspacingunit}\fi}
  {\par\endgroup}
\newcommand{\CSLBlock}[1]{#1\hfill\break}
\newcommand{\CSLLeftMargin}[1]{\parbox[t]{\csllabelwidth}{#1}}
\newcommand{\CSLRightInline}[1]{\parbox[t]{\linewidth - \csllabelwidth}{#1}\break}
\newcommand{\CSLIndent}[1]{\hspace{\cslhangindent}#1}

\RequirePackage{xurl}                  % URLs may break anywhere
\urlstyle{sf}
\newcommand*{\refurlfont}{\small}
\newcommand*{\refurl}[1]{\hspace{0.4em}{\refurlfont\textcolor{inkgray}{\textperiodcentered}\hspace{0.4em}#1}}

\RequirePackage{hyperref}
\hypersetup{
  colorlinks   = true,
  linkcolor    = ink,
  citecolor    = ink,
  urlcolor     = accentdark,
  bookmarksnumbered = true,
  bookmarksopen     = true,
  bookmarksopenlevel = 0,
  pdfpagemode  = UseOutlines,
  pdfdisplaydoctitle = true,
  pdfstartview = Fit,
}
\RequirePackage{bookmark}

\endinput

\renewcommand*{\beforepartskip}{\vspace*{1.5in}}
\newcommand*{\bookpart}[1]{\part{#1}}
\newcommand*{\bookappendixpart}[1]{\appendixparttrue\part*{#1}\appendixpartfalse}

% ---------------------------------------------------------------------------
% Running heads
% ---------------------------------------------------------------------------
\newcommand*{\headfont}{\headingfont\fontsize{7.5}{10}\selectfont
  \addfontfeatures{LetterSpace=10}\color{inkgray}}
\newcommand*{\folio}{\headingfont\fontsize{8.5}{10}\selectfont\color{ink}\thepage}

\makepagestyle{bookpdf}
\makeevenhead{bookpdf}{\folio\hspace{1.4em}\headfont\MakeUppercase{\leftmark}}{}{}
\makeoddhead{bookpdf}{}{}{\headfont\MakeUppercase{\rightmark}\hspace{1.4em}\folio}
\makeevenfoot{bookpdf}{}{}{}
\makeoddfoot{bookpdf}{}{}{}
\nouppercaseheads
\makepsmarks{bookpdf}{%
  \createmark{chapter}{both}{shownumber}{}{\hspace{0.7em}}%
  \createmark{section}{right}{nonumber}{}{}%
  \createplainmark{toc}{both}{\contentsname}%
}
\pagestyle{bookpdf}

